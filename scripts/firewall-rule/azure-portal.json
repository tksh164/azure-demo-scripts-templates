        {
            "Name": "azure-portal-authentication",
            "Priority": 1000,
            "ActionType": "Allow",
            "Rules": [
                { "Name": "login.microsoft.com", "SourceAddress": "*", "Protocol": ["http", "https"], "TargetFqdn": "login.microsoft.com" },
                { "Name": "login.microsoftonline.com", "SourceAddress": "*", "Protocol": ["http", "https"], "TargetFqdn": "login.microsoftonline.com" },
                { "Name": "login.live.com", "SourceAddress": "*", "Protocol": ["http", "https"], "TargetFqdn": "login.live.com" },
                { "Name": "*.aadcdn.msftauth.net", "SourceAddress": "*", "Protocol": ["http", "https"], "TargetFqdn": "*.aadcdn.msftauth.net" },
